# Main upstream origin and exact initial page
UPSTREAM_ORIGIN=https://www.easyfun.gg
UPSTREAM_PATH=/cloud-games/roblox.html

# Public externally-reachable origin of this proxy, no path or trailing slash
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Comma-separated additional exact hostnames ONLY after confirming they are required.
# Primary UPSTREAM_ORIGIN hostname is always allowlisted. Avoid wildcard entries.
ALLOWED_HOSTNAMES=

# Scramjet transport only accepts TCP to the exact UPSTREAM_ORIGIN hostname on ports 80/443.
# UDP, direct-IP destinations, private/loopback IPs, and other hostnames are blocked.
# The game page may load linked APIs/assets outside the current hostname; discover and add
# only verified hosts after testing, because this strict allowlist intentionally blocks them.
